# Configuration Handlers
#
# Ce fichier se charge de gérer les fichiers de configurations

function show_env_config(){
  echo "$(yellow "Inspect_args output"): "
  inspect_args

  echo "$(yellow "Used environment variables (from $ENV_FILE)"): "
  echo "$(grep 'DOMAIN' $ENV_FILE)"
  echo "$(grep 'EMAIL' $ENV_FILE)"
  echo "$(grep 'WEBSRC' $ENV_FILE)"

  echo "$(yellow "Used environment variables (from runtime)"): "
  echo "DOMAIN=$DOMAIN"
  echo "EMAIL=$EMAIL"
  echo "WEBSRC=$WEBSRC"
}

function set_domain(){
  cp $ENV_FILE .env.run   # Copie du fichier utilisateur $ENV_FILE en un .env.run utilisable par les docker-compose.yml
  cp /etc/hosts "./backups/hosts-$(date +%Y-%m-%d).backup"
  echo "127.0.0.2 $DOMAIN" >> /etc/hosts
}

function reset_domain(){
  sed -i "/$DOMAIN/d" /etc/hosts
}

# :command.command_functions

# :command.parse_requirements
parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version)
        version_command
        exit
        ;;

      --help)
        long_usage=yes
        esnac_cli_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.environment_variables_filter
  # :command.environment_variables_default
  export ENV_FILE="${ENV_FILE:-.env}"
  export DOMAIN="${DOMAIN:-portal.poc}"
  export EMAIL="${EMAIL:-admin@portal.poc}"

  env_var_names+=("ENV_FILE")
  env_var_names+=("DOMAIN")
  env_var_names+=("EMAIL")

  # :command.command_filter
  action="root"

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      # :flag.case
      --delete | -d)

        # :flag.case_arg
        if [[ -n ${2+x} ]]; then
          args['--delete']="$2"
          shift
          shift
        else
          printf "%s\n" "--delete requires an argument: --delete, -d CONTAINER" >&2
          exit 1
        fi
        ;;

      # :flag.case
      --help | -h)

        # :flag.case_no_arg
        args['--help']=1
        shift
        ;;

      # :flag.case
      --name | -n)

        # :flag.case_arg
        if [[ -n ${2+x} ]]; then
          args['--name']="$2"
          shift
          shift
        else
          printf "%s\n" "--name requires an argument: --name, -n NAME" >&2
          exit 1
        fi
        ;;

      # :flag.case
      --run | -r)

        # :flag.case_arg
        if [[ -n ${2+x} ]]; then
          args['--run']="$2"
          shift
          shift
        else
          printf "%s\n" "--run requires an argument: --run, -r CONTAINER" >&2
          exit 1
        fi
        ;;

      # :flag.case
      --update | -u)

        # :flag.case_arg
        if [[ -n ${2+x} ]]; then
          args['--update']="$2"
          shift
          shift
        else
          printf "%s\n" "--update requires an argument: --update, -u CONTAINER" >&2
          exit 1
        fi
        ;;

      # :flag.case
      --verbose | -v)

        # :flag.case_no_arg
        args['--verbose']=1
        shift
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        # :argument.case
        if [[ -z ${args['service']+x} ]]; then
          args['service']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

        ;;

    esac
  done

  # :command.needy_flags_filter
  # :flag.needs
  if [[ -n ${args['--name']+x} ]] && [[ -z "${args[--run]:-}" ]]; then
    printf "%s\n" "--name needs --run" >&2
    exit 1
  fi

}

# :command.initialize
initialize() {
  declare -g version="0.1"
  set -e

  # :command.environment_variables_default
  export ENV_FILE="${ENV_FILE:-.env}"
  export DOMAIN="${DOMAIN:-portal.poc}"
  export EMAIL="${EMAIL:-admin@portal.poc}"

}

# :command.run
run() {
  # :command.globals
  declare -g long_usage=''
  declare -g -A args=()
  declare -g -A deps=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "root") root_command ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  # :command.start
  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
fi
